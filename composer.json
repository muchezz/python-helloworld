{
    "name": "njiracloud-fixtures/symfony",
    "type": "project",
    "description": "Phase 6B.1 real-acceptance fixture: minimal Symfony micro-kernel app.",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/framework-bundle": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}